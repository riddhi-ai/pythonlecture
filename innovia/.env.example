# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local URI)
# If left blank or connection fails, the server gracefully falls back to an embedded in-memory MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/creator_innovia?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=innovia_creator_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=innovia_creator_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Notifications (optional - simulated in-app if credentials not provided)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@creatorinnovia.local
